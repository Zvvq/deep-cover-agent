DEEP_COVER_AGENT_INTERNAL_AGENT_SECRET=dev-agent-secret
DEEP_COVER_AGENT_JAVA_BASE_URL=http://localhost:8080
DEEP_COVER_AGENT_ENABLE_LANGCHAIN=true
DEEP_COVER_AGENT_DEEPSEEK_API_KEY=your-deepseek-api-key
DEEP_COVER_AGENT_DEEPSEEK_MODEL=deepseek-v4-flash
DEEP_COVER_AGENT_DEEPSEEK_TEMPERATURE=0.7
DEEP_COVER_AGENT_DEEPSEEK_THINKING_ENABLED=false
DEEP_COVER_AGENT_IDLE_CHECK_INTERVAL_SECONDS=5
DEEP_COVER_AGENT_IDLE_SPEECH_AFTER_SECONDS=30
DEEP_COVER_AGENT_MESSAGE_HISTORY_LIMIT=50
DEEP_COVER_AGENT_SPEECH_BASE_DELAY_SECONDS=1.5
DEEP_COVER_AGENT_SPEECH_TYPING_SECONDS_PER_CHAR=0.5
DEEP_COVER_AGENT_SPEECH_MAX_DELAY_SECONDS=30
DEEP_COVER_AGENT_SPEECH_RETRY_DELAY_SECONDS=3
DEEP_COVER_AGENT_SPEECH_CONTEXT_REACTION_DELAY_SECONDS=2
DEEP_COVER_AGENT_SPEECH_REVISION_EXTRA_DELAY_SECONDS=4
DEEP_COVER_AGENT_SPEECH_MAX_SEGMENTS=3
DEEP_COVER_AGENT_PENDING_SPEECH_MAX_REVIEWS=2
